# ==============================================================================
# Document Intelligence Pipeline - Environment Variables Example
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the root of your project.
# 2. Uncomment and modify the values below to override the default settings.
# 3. For a full list of configuration options, see `app/config.py`.
# ==============================================================================

# --- Upload & Processing Limits ---
# MAX_UPLOAD_MB=50
# MAX_PDF_PAGES=500

# --- OCR Configuration ---
# DEFAULT_OCR_ENGINE=rapidocr        # Supported options: 'rapidocr' or 'tesseract'
# DEFAULT_OCR_LANGUAGES=eng+spa

# --- Queue & Retry Policies ---
# MAX_ATTEMPTS=3                     # Max retry attempts for failed jobs
# STALE_HEARTBEAT_S=45               # Seconds before a worker is considered dead
# REDISPATCH_AFTER_S=60              # Seconds before re-assigning a stalled job
# QUEUED_TTL_S=86400                 # Time-to-live for jobs in queue (24 hours)

# --- Worker Performance & Concurrency ---
# HEAVY_CONCURRENCY=2                # Number of OCR processes per worker-heavy container
# OCR_THREADS=2                      # Number of ONNX Runtime threads per OCR process
