# Copy to .env to override defaults (see app/config.py for the full list)
# MAX_UPLOAD_MB=50
# MAX_PDF_PAGES=500
# DEFAULT_OCR_ENGINE=rapidocr        # or tesseract
# DEFAULT_OCR_LANGUAGES=eng+spa
# MAX_ATTEMPTS=3
# STALE_HEARTBEAT_S=45
# REDISPATCH_AFTER_S=60
# QUEUED_TTL_S=86400
# HEAVY_CONCURRENCY=2                # OCR processes per worker-heavy container
# OCR_THREADS=2                      # ONNX Runtime threads per OCR process
